<?xml version="1.0" encoding="utf-8"?>
<!-- Glass disc: translucent white pane, soft top highlight, thin bright edge.
     Focus is shown by a brighter pane and edge only; no scaling or fades. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="0"
    android:exitFadeDuration="0">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#40FFFFFF" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:endColor="#00FFFFFF"
                        android:startColor="#33FFFFFF" />
                    <stroke android:width="2dp" android:color="#E6FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#1AFFFFFF" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:endColor="#00FFFFFF"
                        android:startColor="#1FFFFFFF" />
                    <stroke android:width="1dp" android:color="#47FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
